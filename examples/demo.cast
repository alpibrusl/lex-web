[20.840991, "o", "\u001b[1m\u001b[34m$\u001b[0m  # alice  →  ws://127.0.0.1:9100/ws/alice\r\n"]
[21.871699, "o", "  alice  →  \u001b[1m/join general\u001b[0m\r\n"]
[21.896494, "o", "  alice  ←  ok join general\r\n\r\n"]
[22.910386, "o", "\r\n\u001b[2m"]
[22.91081, "o", "────────────────────────────────────────────────────────────────────────\u001b[0m\r\n  \u001b[1m\u001b[36mREST — rooms, users, broadcast, DM, server-rendered history\u001b[0m\r\n\u001b[2m"]
[22.911089, "o", "────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n\r\n"]
[23.426025, "o", "\u001b[1m\u001b[34m$\u001b[0m  curl -s http://127.0.0.1:9000/rooms | jq\r\n"]
[24.48513, "o", "\u001b[1;39m[\r\n  \u001b[0;32m\"general\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[24.485603, "o", "\r\n"]
[25.295511, "o", "\u001b[1m\u001b[34m$\u001b[0m  curl -s http://127.0.0.1:9000/users | jq\r\n"]
[26.357484, "o", "\u001b[1;39m[\r\n  \u001b[0;32m\"alice\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[26.357861, "o", "\r\n"]
[27.166272, "o", "\u001b[1m\u001b[34m$\u001b[0m  curl -sX POST http://127.0.0.1:9000/say \\\r\n"]
[27.787298, "o", "     -H 'content-type: application/json' \\\r\n     -d '{\"room\":\"general\",\"from\":\"ops\",\"body\":\"deploy in 5 min\"}' | jq\r\n"]
[28.203319, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"sent\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"room\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"general\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[28.203518, "o", "\r\n"]
[28.533178, "o", "  alice  ←  [general] ops: deploy in 5 min\r\n\r\n"]
[29.337857, "o", "\u001b[1m\u001b[34m$\u001b[0m  curl -sX POST http://127.0.0.1:9000/dm/alice \\\r\n"]
[29.950846, "o", "     -H 'content-type: application/json' \\\r\n     -d '{\"from\":\"system\",\"body\":\"session ends in 1h\"}' | jq\r\n"]
[30.404182, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"sent\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"to\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"alice\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[30.404665, "o", "\r\n"]
[30.741795, "o", "  alice  ←  (dm from system) session ends in 1h\r\n\r\n"]
[31.549886, "o", "\u001b[1m\u001b[34m$\u001b[0m  curl -s http://127.0.0.1:9000/history.html\r\n"]
[32.605235, "o", "<!doctype html><meta charset=utf-8><title>chat presence</title><table border=1><tr><th>user</th><th>room</th></tr><tr><td>alice</td><td>general</td></tr></table>"]
[32.606172, "o", "\r\n"]
[34.112285, "o", "\u001b[2m"]
[34.112845, "o", "────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[32mDONE\u001b[0m\r\n\r\n  HTTP :9000  +  WebSocket :9100  in one process.\r\n  Named actors. Room membership. HTTP→WS broadcast. DM. Server-rendered HTML.\r\n  9 effects declared and verified before a byte ran.\r\n\r\n\u001b[2m"]
[34.113459, "o", "────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n"]
