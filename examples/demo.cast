[4.619452, "o", "\u001b[1m\u001b[34m$\u001b[0m  grep 'fn main' examples/chat_app.lex\r\n"]
[5.251308, "o", "fn main() -> [io, net, concurrent, time, crypto, random, sql, fs_read, fs_write] Unit {\r\n"]
[5.25219, "o", "\r\n"]
[6.06267, "o", "\u001b[1m\u001b[34m$\u001b[0m  lex check examples/chat_app.lex\r\n"]
[7.161703, "o", "ok\r\nrequired effects: concurrent, crypto, fs_read, fs_write, io, net, random, sql, time\r\nhint: lex run --allow-effects concurrent,crypto,fs_read,fs_write,io,net,random,sql,time examples/chat_app.lex <fn> [args]\r\n"]
[7.162768, "o", "\u001b[32m\u001b[1m✓  ok\u001b[0m  — 9 effects verified at compile time\r\n\r\n"]
[8.667699, "o", "\r\n\u001b[2m"]
