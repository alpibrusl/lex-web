[0.014171, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.014514, "o", "\r\n  \u001b[1mlex-web\u001b[0m  ·  HTTP + WebSocket, actor-model real-time chat\r\n  \u001b[2mOne process. Two listeners. Named actors. Effect-typed.\u001b[0m\r\n\r\n"]
