[0.013618, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.013869, "o", "\r\n  \u001b[1mlex-web\u001b[0m  .  one schema, every artifact\r\n  \u001b[2mOne ModelSchema. Six artifacts. Zero duplication.\u001b[0m\r\n\r\n"]
[1.51854, "o", "\r\n\u001b[2m"]
[1.519066, "o", "------------------------------------------------------------------------\u001b[0m\r\n  \u001b[1m\u001b[36mThe Order schema -- defined exactly once\u001b[0m\r\n\u001b[2m"]
[1.519512, "o", "------------------------------------------------------------------------\u001b[0m\r\n\r\n"]
[1.543622, "o", "  Six"]
[1.725214, "o", " field"]
[1.816028, "o", "s. Co"]
[1.909101, "o", "nstrai"]
[2.002303, "o", "nts i"]
[2.097834, "o", "nline."]
[2.189459, "o", " No s"]
