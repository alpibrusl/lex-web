[2.377934, "o", "e Pyd"]
[2.469445, "o", "antic "]
[2.565199, "o", "model"]
[2.658835, "o", ",\r\n"]
[2.68204, "o", "  no "]
[2.880498, "o", "SQLAlc"]
[2.962717, "o", "hemy "]
[3.057731, "o", "class,"]
[3.152822, "o", " no A"]
[3.247811, "o", "lembic"]
